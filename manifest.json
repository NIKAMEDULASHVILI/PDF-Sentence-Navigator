{
  "manifest_version": 3,
  "name": "PDF Sentence Navigator",
  "version": "1.0.0",
  "description": "Open local PDF files and navigate between sentences with TAB / SHIFT+TAB. Everything runs locally in the browser.",

  "icons": {
    "16": "icons/pdf-logo.svg",
    "48": "icons/pdf-logo.svg",
    "128": "icons/pdf-logo.svg"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pdf-logo.svg",
      "48": "icons/pdf-logo.svg",
      "128": "icons/pdf-logo.svg"
    }
  },

  "permissions": [
    "storage",
    "unlimitedStorage"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "lib/*",
        "css/*",
        "js/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}